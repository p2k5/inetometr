# Конфигурация для systemd службы Inetometr
# Скопируйте в /etc/inetometr/.env и настройте значения

# Токен администратора (обязательно)
INETOMETR_ADMIN_TOKEN=change_this_to_a_secure_random_token

# Порт и хост сервера
PORT=8080
HOST=0.0.0.0

# Путь к файлу данных
INETOMETR_DATA=/opt/inetometr/data/speed_data.json
INETOMETR_DB=/opt/inetometr/data/speed_data.db

# CORS (по умолчанию "*" для разработки, в продакшене укажите конкретные origin)
INETOMETR_CORS_ORIGINS=*

# Принудительный HTTPS редирект (задействуетсь только за reverse proxy)
INETOMETR_FORCE_HTTPS=false

# Разрешенные хосты (TrustedHost middleware)
INETOMETR_ALLOWED_HOSTS=*

# Лимиты rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
