# Inetometr Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real secrets to version control!

# ─────────────────────────────────────────────────────────────────────
# Server settings
# ─────────────────────────────────────────────────────────────────────
# Host to bind the server to
HOST=0.0.0.0
# HTTP server port
PORT=8080

# ─────────────────────────────────────────────────────────────────────
# Data storage
# ─────────────────────────────────────────────────────────────────────
# Path to legacy JSON Lines history file (used for one-time migration to SQLite)
INETOMETR_DATA=data/speed_data.json
# Path to SQLite database file for measurements history
INETOMETR_DB=data/speed_data.db

# ─────────────────────────────────────────────────────────────────────
# Admin panel - REQUIRED in production!
# ─────────────────────────────────────────────────────────────────────
# Bearer token for /admin and /api/status endpoints.
# MUST be set to a strong random value in production (e.g., `openssl rand -hex 32`).
# Without this token, /admin returns 503 Service Unavailable.
# Example: INETOMETR_ADMIN_TOKEN=supersecret_random_token_123
INETOMETR_ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
# Use specific origins in production (e.g., "https://inetometr.ru,https://www.inetometr.ru")
# Wildcard "*" is allowed for development but DISABLES credentials (cookies/auth headers).
# If empty or not set, defaults to "*" (all origins, no credentials).
INETOMETR_CORS_ORIGINS=*

# ─────────────────────────────────────────────────────────────────────
# Security
# ─────────────────────────────────────────────────────────────────────
# Force HTTPS redirect in production (set to "true" behind reverse proxy with SSL termination).
# Only enable when running behind a trusted reverse proxy that sets X-Forwarded-Proto.
# Values: "true", "1", "yes" (case-insensitive) to enable; anything else to disable.
INETOMETR_FORCE_HTTPS=false

# Comma-separated list of allowed hostnames for TrustedHostMiddleware.
# Prevents Host header injection attacks. Required when running behind reverse proxy.
# Example: "inetometr.ru,www.inetometr.ru,localhost"
# If empty or not set, middleware is not added.
INETOMETR_ALLOWED_HOSTS=

# ─────────────────────────────────────────────────────────────────────
# Rate limiting (optional tuning)
# ─────────────────────────────────────────────────────────────────────
# Max requests per IP per window (default: 60 requests / 60 seconds)
# INETOMETR_RATE_LIMIT_REQUESTS=60
# Rate limit window in seconds (default: 60)
# INETOMETR_RATE_LIMIT_WINDOW=60