# Inetometr Environment Variables
# Copy this file to .env and fill in your values

# Server settings
HOST=0.0.0.0
PORT=8080

# Data storage
INETOMETR_DATA=data/speed_data.json
INETOMETR_DB=data/speed_data.db

# Admin panel - REQUIRED: set a strong secret token!
INETOMETR_ADMIN_TOKEN=your_secure_admin_token_here

# CORS origins (comma-separated, or * for all)
INETOMETR_CORS_ORIGINS=*

# Security
# Force HTTPS redirect in production (set to true behind reverse proxy with SSL)
INETOMETR_FORCE_HTTPS=false

# Allowed hosts for TrustedHostMiddleware (comma-separated)
INETOMETR_ALLOWED_HOSTS=inetometr.ru,www.inetometr.ru